# ─── Database — Supabase PostgreSQL ───────────────────────────────
# IMPORTANT: The app uses DIRECT_DATABASE_URL (port 5432) at runtime
# for interactive transactions. DATABASE_URL (port 6543, pgbouncer) is
# used only for Prisma migrations and as a fallback.
#
# The code in src/lib/db.ts automatically:
#   1. Prefers DIRECT_DATABASE_URL (port 5432)
#   2. Appends connection_limit=1 to prevent pool exhaustion on Vercel
#   3. Caches PrismaClient in globalThis (one client per function instance)

# Pooled connection (pgbouncer, port 6543) — for Prisma migrations only
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"

# Direct connection (port 5432, NO pgbouncer) — for app runtime
# THIS is what the Prisma client uses at runtime.
DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────
NEXTAUTH_URL="https://your-app.vercel.app"
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── Audit Log Security ───────────────────────────────────────────
# Internal secret required by the /api/audit-logs POST endpoint.
AUDIT_INTERNAL_SECRET="generate-with-openssl-rand-base64-32"

# ─── Bootstrap Admin (emergency admin password) ────────────────────
# Used by POST /api/bootstrap-admin to create or reset admin@demo.com
# when no admin exists yet or the password is lost. Strong string
# (≥ 16 chars) — without it, /api/bootstrap-admin returns 500.
# BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-16+-char-string"

# ─── Optional: Enable Admin DDL endpoints in production ───────────
# Set to "true" ONLY for emergency schema fixes. DDL should normally
# run via Prisma migrations, not via API endpoints. When unset in
# production (NODE_ENV=production), these routes return
# 403 admin-ddl-disabled-in-production:
#   /api/admin/recalc-stock, /api/admin/fix-stock,
#   /api/admin/clear-transactions, /api/admin/apply-*-schema,
#   /api/admin/create-supplier-payment-table, /api/admin/apply-indexes,
#   /api/admin/analyze, /api/seed
# ENABLE_ADMIN_DDL="true"

# ─── Seed passwords (for POST /api/seed) ───────────────────────────
# When seeding demo data via /api/seed, these set the passwords for
# the seeded demo users. If any is unset, /api/seed generates a strong
# random password and returns it in the response body (it is NOT
# persisted anywhere else). All optional in development; strongly
# recommended in production to avoid returning secrets in HTTP
# responses.
# SEED_ADMIN_PASSWORD="replace-with-strong-password"
# SEED_MANAGER_PASSWORD="replace-with-strong-password"
# SEED_ACCOUNTANT_PASSWORD="replace-with-strong-password"
# SEED_SALES_PASSWORD="replace-with-strong-password"
# SEED_WAREHOUSE_PASSWORD="replace-with-strong-password"
# SEED_CASHIER_PASSWORD="replace-with-strong-password"

# ─── Optional Integrations ────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ACCESS_TOKEN=""
